# ─── Vast.ai Instance Connection ───────────────────────────────────────
# SSH directly to instance IP
SSH_HOST=98.142.241.120
SSH_PORT=20390
SSH_USER=root

# SSH via Vast.ai proxy (fallback)
SSH_PROXY_HOST=ssh1.vast.ai
SSH_PROXY_PORT=36853

# ─── Network ───────────────────────────────────────────────────────────
SSH_COMMAND="ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST}"
SSH_PROXY_COMMAND="ssh -p ${SSH_PROXY_PORT} ${SSH_USER}@${SSH_PROXY_HOST}"

# ─── Pearl Node (pearld) ───────────────────────────────────────────────
PEARLD_RPC_URL=http://127.0.0.1:44107
PEARLD_RPC_USER=rpcuser
PEARLD_RPC_PASSWORD=rpcpass
PEARLD_RPC_PORT=44107
PEARLD_P2P_PORT=44108

# ─── Wallet ────────────────────────────────────────────────────────────
MINING_ADDRESS=prl1pmt5e954cpepqmvnpm8sfywmjhvupjpdd5trtkdw8jca86auuvlls45s2x8

# ─── Python Environment ────────────────────────────────────────────────
VENV_PATH=/workspace/pearl-venv
PYTHONPATH=~/pearl-cion/miner/pearl-gemm/src

# ─── Miner Settings ────────────────────────────────────────────────────
MINER_NOISE_RANGE=256
MINER_P=8
MINER_Q=8
MINER_NOISE_RANK=128
MINER_TILE_SIZE_M=64
MINER_TILE_SIZE_N=64
MINER_TILE_SIZE_K=128
MINER_NUM_JOBS=1
MINER_RPC_SOCKET_PATH=/tmp/pearlgw.sock
MINER_RPC_TRANSPORT=uds
MINER_RPC_HOST=localhost
MINER_RPC_PORT=8337

# ─── CUDA Environment ──────────────────────────────────────────────────
CUDA_HOME=/usr/local/cuda
TORCH_EXTENSION_SKIP_CUDA_VERSION_CHECK=1
MAX_JOBS=4

# ─── Instance Info ────────────────────────────────────────────────────
INSTANCE_IP=98.142.241.120
INSTANCE_PORT=20390
GPU_NAME=RTX_4060_Ti
GPU_COUNT=1
